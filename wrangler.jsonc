// Scolavis auf Cloudflare Workers. Cloudflare baut bei jedem Push auf „main" automatisch („Workers Builds",
// Befehl: npx wrangler deploy). Es gibt keinen Build-Schritt – die Dateien werden so ausgeliefert, wie sie hier liegen.
{
  "name": "scolavis",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Welche Dateien veröffentlicht werden, steht in .assetsignore (Erlaubnisliste!).
  // html_handling "none": jede Datei liegt genau unter ihrem Namen – /index.html ist die Tafel und wird NICHT auf „/"
  // umgeleitet. Alles, wozu es keine Datei gibt („/", /app, /handy, /api/…), beantwortet cloudflare/worker.js.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Bremse für die Server-Funktionen (/api/*), gezählt von Cloudflare pro Standort (siehe overLimit in worker.js):
  // RL_IP = höchstens 60 Aufrufe pro Minute je IP-Adresse (eine ganze Schule surft oft unter einer Adresse),
  // RL_ALL = höchstens 600 pro Minute insgesamt. Der eigentliche Kostendeckel gehört zusätzlich zu Google (Kontingent).
  "ratelimits": [
    { "name": "RL_IP",  "namespace_id": "1001", "simple": { "limit": 60,  "period": 60 } },
    { "name": "RL_ALL", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],

  // ══════════ KI-KONTINGENT – die EINE Stelle, an der die Grenzen stehen ══════════
  // Ändern: Zahl hier anpassen und pushen (gilt nach etwa einer Minute, für alle Konten, auch im laufenden Monat).
  // Gezählt wird pro Konto und Kalendermonat (supabase/ki-kontingent.sql); ohne Anmeldung gibt es keine KI.
  // Kosten (Stand Nov 2026, Gemini 2.5 Flash): eine Frage ≈ 0,12 Cent, eine Bildersuche ≈ 0,01 Cent.
  //   Einfach voll ausgenutzt ≈ 4 Cent/Monat je Konto, Pro ≈ 65 Cent/Monat je Konto.
  //   KI_GESAMT_* = Deckel für ALLE Konten zusammen: 20000 Fragen ≈ 24 €, 40000 Bilder ≈ 4 € → höchstens ≈ 28 €/Monat.
  //   Dahinter steht als letzte Sicherung die Ausgabenobergrenze bei Google (AI Studio → Ausgaben).
  // KI_AN: "nein" schaltet den KI-Assistenten und die Bildersuche sofort für alle ab (Notschalter).
  "vars": {
    "KI_AN": "ja",
    "KI_FRAGEN_EINFACH": 30,
    "KI_FRAGEN_PRO": 500,
    "KI_BILDER_EINFACH": 60,
    "KI_BILDER_PRO": 600,
    "KI_GESAMT_FRAGEN": 20000,
    "KI_GESAMT_BILDER": 40000
  },

  // Fehlermeldungen der Server-Funktionen im Cloudflare-Protokoll (Worker → Logs)
  "observability": { "enabled": true }
}
