// Scolavis auf Cloudflare Workers. Cloudflare baut bei jedem Push auf „main" automatisch („Workers Builds",
// Befehl: npx wrangler deploy). Es gibt keinen Build-Schritt – die Dateien werden so ausgeliefert, wie sie hier liegen.
{
  "name": "scolavis",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Welche Dateien veröffentlicht werden, steht in .assetsignore (Erlaubnisliste!).
  // html_handling "none": jede Datei liegt genau unter ihrem Namen – /index.html ist die Tafel und wird NICHT auf „/"
  // umgeleitet. Alles, wozu es keine Datei gibt („/", /app, /handy, /api/…), beantwortet cloudflare/worker.js.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // Bremse für die Server-Funktionen (/api/*), gezählt von Cloudflare pro Standort (siehe overLimit in worker.js):
  // RL_IP = höchstens 60 Aufrufe pro Minute je IP-Adresse (eine ganze Schule surft oft unter einer Adresse),
  // RL_ALL = höchstens 600 pro Minute insgesamt. Der eigentliche Kostendeckel gehört zusätzlich zu Google (Kontingent).
  "ratelimits": [
    { "name": "RL_IP",  "namespace_id": "1001", "simple": { "limit": 60,  "period": 60 } },
    { "name": "RL_ALL", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],

  // Fehlermeldungen der Server-Funktionen im Cloudflare-Protokoll (Worker → Logs)
  "observability": { "enabled": true }
}
