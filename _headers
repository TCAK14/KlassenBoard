# Kopfzeilen für die ausgelieferten Dateien bei Cloudflare (dieselben Regeln stehen für Netlify in netlify.toml).
# „! Cache-Control" entfernt zuerst Cloudflares Standardwert, sonst würden beide Werte zusammengehängt.

# Lokal gehostete Schrift und Bibliotheken mit Version im Dateinamen: ändern sich nie → lange im Browser behalten
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# App (PWA): Service Worker immer frisch prüfen, Manifest kurz, Symbole eine Woche
/sw.js
  ! Cache-Control
  Cache-Control: no-cache

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=3600

/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
