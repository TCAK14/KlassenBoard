# Kopfzeilen für die ausgelieferten Dateien bei Cloudflare (dieselben Regeln stehen für Netlify in netlify.toml).
# „! Cache-Control" entfernt zuerst Cloudflares Standardwert, sonst würden beide Werte zusammengehängt.

# Lokal gehostete Schrift und Bibliotheken mit Version im Dateinamen: ändern sich nie → lange im Browser behalten
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# App (PWA): Service Worker immer frisch prüfen, Manifest kurz, Symbole eine Woche
/sw.js
  ! Cache-Control
  Cache-Control: no-cache

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=3600

/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=604800

# Sicherheits-Kopfzeilen für alle ausgelieferten Dateien
# - HSTS: Browser rufen die Seite danach nur noch verschlüsselt auf (zusätzlich „Always Use HTTPS" im Cloudflare-Dashboard)
# - frame-ancestors: Scolavis darf nicht in fremde Seiten eingebettet werden (Schutz vor untergeschobenen Klicks)
# - Kamera/Mikrofon nur für die eigene Seite, nie für eingebettete Fremdseiten
/*
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'
